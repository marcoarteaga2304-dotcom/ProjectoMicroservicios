PORT=3000
APP_URL=http://localhost:3000
# Con Docker Compose, DB_HOST se reemplaza automáticamente por 'db'
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=cambia_esta_clave
DB_NAME=glowcosmetics_db
JWT_SECRET=escribe-aqui-una-cadena-larga-y-aleatoria

# Envío: costo fijo y monto desde el cual es gratis (0 = nunca gratis)
ENVIO_COSTO=99
ENVIO_GRATIS_DESDE=1500

# PayPal (Sandbox para pruebas)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Correo (opcional). Sin SMTP_HOST los correos solo se muestran en la consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=GlowCosmetics <tu-correo@dominio.com>
CONTACTO_EMAIL=contacto@tudominio.com

# Datos que aparecen en el Aviso de Privacidad
NEGOCIO_NOMBRE=GlowCosmetics
NEGOCIO_DOMICILIO=Querétaro, México

# Solo cuando publiques la tienda detrás de HTTPS / proxy inverso
TRUST_PROXY=0
FORZAR_HTTPS=0