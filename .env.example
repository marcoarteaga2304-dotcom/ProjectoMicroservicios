PORT=3000
APP_URL=http://localhost:3000

# Base de datos (con Docker Compose, DB_HOST se reemplaza automáticamente por 'db')
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=glowcosmetics_db

# Cadena larga y aleatoria para firmar las sesiones
JWT_SECRET=escribe-aqui-una-cadena-larga-y-aleatoria

# Envío: costo fijo y monto desde el cual es gratis (0 = nunca gratis)
ENVIO_COSTO=99
ENVIO_GRATIS_DESDE=1500

# --- PayPal (único método de pago) ---
# Modo de pruebas: sandbox. Usa "live" solo con una cuenta Business real (cobra dinero de verdad).
PAYPAL_MODE=sandbox
# Credenciales de la app Sandbox: developer.paypal.com > Apps & Credentials
PAYPAL_CLIENT_ID=tu_client_id_de_sandbox
PAYPAL_SECRET=tu_secret_de_sandbox

# --- Correo (SMTP). Si SMTP_HOST queda vacío, los correos solo se muestran en la consola ---
# Gmail (contraseña de aplicación, sin espacios):  smtp.gmail.com / 587
# Brevo:     copia host, puerto, usuario y clave de "SMTP & API"
# Mailtrap (bandeja de pruebas, no llega a correos reales): sandbox.smtp.mailtrap.io / 2525
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=GlowCosmetics <tu-correo@dominio.com>

# --- Datos del negocio (aparecen en el Aviso de Privacidad y en Contacto) ---
NEGOCIO_NOMBRE=GlowCosmetics
NEGOCIO_DOMICILIO=Querétaro, México
# Correo de contacto y del Departamento de Datos Personales (solicitudes ARCO)
CONTACTO_EMAIL=contacto@tudominio.com

# Solo cuando publiques la tienda detrás de HTTPS / proxy inverso
TRUST_PROXY=0
FORZAR_HTTPS=0